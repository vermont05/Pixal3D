+void CuMesh::compute_face_areas() {
+    size_t F = this->faces.size;
+    this->face_areas.resize(F);
+   hipLaunchKernelGGL(( compute_face_areas_kernel), dim3((F + BLOCK_SIZE - 1) / BLOCK_SIZE), dim3(BLOCK_SIZE), 0, 0, 
