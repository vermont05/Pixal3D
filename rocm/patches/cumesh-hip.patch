+__device__ inline void unpack_key_value_positive(uint64_t key_value, int& key, float& value) {
+    key = static_cast<int>(key_value & 0xffffffffu);
+    value = __uint_as_float(static_cast<unsigned int>(key_value >> 32));
+}
