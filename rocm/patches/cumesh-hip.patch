+    // (0,3)
+    res += 2.0f * e[3] * x * w;
+    // (1,1)
+    res += e[4] * y * y;
+    // (1,2)
+    res += 2.0f * e[5] * y * z;
+    // (1,3)
+    res += 2.0f * e[6] * y * w;
+    // (2,2)
+    res += e[7] * z * z;
+    // (2,3)
+    res += 2.0f * e[8] * z * w;
+    // (3,3)
+    res += e[9] * w * w;
