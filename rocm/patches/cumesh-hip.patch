+static __global__ void get_edge_collapse_cost_kernel(
+    const float3* vertices,
+    const int3* faces,
+    const int* vert2face,
+    const int* vert2face_offset,
+    const uint64_t* edges,
+    const uint8_t * vert_is_boundary,
