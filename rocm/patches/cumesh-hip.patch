+    int f = conn_comp_ids[tid] & 1;
+    while (p != (conn_comp_ids[p] >> 1)) {
+        f ^= conn_comp_ids[p] & 1;
+        p = conn_comp_ids[p] >> 1;
+    }
+    conn_comp_ids[tid] = (p << 1) | f;
+}
